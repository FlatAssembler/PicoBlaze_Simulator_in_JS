; bilbo.psm
; Solve Bilbo (Infokup 2013) by iterative backtracking (same idea as <a href="https://flatassembler.github.io/bilbo">bilbo.aec</a>)
; Reads 6 digits from UART, arranges into two 3-digit numbers maximizing sum < 1000.
; Uses UART_RX, UART_TX, print_string conventions from the repository.

base_decimal
constant NDEBUG, 0
constant DIGIT_COUNT, 10
constant ATTEMPT_LENGTH, 6
constant LAST_ATTEMPT_INDEX, ATTEMPT_LENGTH - 1
constant COUNTS_BASE, 0
constant ATTEMPT_BASE, 10
constant NEXT_TRY_BASE, 20
constant COUNTS_USED_BASE, 30
constant BEST_FOUND_FLAG, 48
constant BEST_SUM_LOW, 49
constant BEST_SUM_HIGH, 50
constant CANDIDATE_FIRST_LOW, 51
constant CANDIDATE_FIRST_HIGH, 52
constant CANDIDATE_SECOND_LOW, 53
constant CANDIDATE_SECOND_HIGH, 54
constant BEST_FIRST_LOW, 55
constant BEST_FIRST_HIGH, 56
constant BEST_SECOND_LOW, 57
constant BEST_SECOND_HIGH, 58
constant TEN, 10
constant HUNDRED, 100
constant MAX_SUM_EXCLUSIVE, 1000

address 0

regbank a

; Memory layout in scratchpad (addresses):
; 0..9    counts[0..9]
; 10..15  attempt[0..5]
; 20..25  next_try[0..5]
; 30..39  counts_used[0..9]
; 48      best_found_flag
; 49..50  best_sum_lo, best_sum_hi
; 51..52  candidate_first_lo, candidate_first_hi (current attempt's decomposition)
; 53..54  candidate_second_lo, candidate_second_hi (current attempt's decomposition)
; 55..56  best_first_lo, best_first_hi
; 57..58  best_second_lo, best_second_hi

; --- Entry ---
print_string "Enter 6 digits in the UART input.\n", s9, UART_TX
call init_memory_and_prompt
call read_six_digits       ; fills counts[0..9]
call backtracking_search   ; finds best sum / decomposition
call print_result
infinite_loop: jump infinite_loop

; -------------------------
; init: zero relevant memory & prompt
init_memory_and_prompt:
  ; zero counts (0..9)
  load s0, 0
  load s1, 0
zero_counts_loop:
  compare s1, DIGIT_COUNT
  jump z, zero_counts_done
  store s0, (s1)
  add s1, 1
  jump zero_counts_loop
zero_counts_done:
  ; zero counts_used (30..39)
  load s1, 0
zero_used_loop:
  compare s1, DIGIT_COUNT
  jump z, zero_used_done
  ; compute pointer = COUNTS_USED_BASE + s1 into s7
  load s7, COUNTS_USED_BASE
  add s7, s1
  store s0, (s7)
  add s1, 1
  jump zero_used_loop
zero_used_done:
  ; zero next_try & attempt (6 entries)
  load s1, 0
zero_nt_loop:
  compare s1, ATTEMPT_LENGTH
  jump z, zero_nt_done
  ; store 0 into next_try[s1] at NEXT_TRY_BASE + s1
  load s7, NEXT_TRY_BASE
  add s7, s1
  load s0, 0
  store s0, (s7)   ; next_try[d] = 0
  ; store 0 into attempt[s1] at ATTEMPT_BASE + s1
  load s7, ATTEMPT_BASE
  add s7, s1
  load s0, 0
  store s0, (s7)   ; attempt[d] = 0
  add s1, 1
  jump zero_nt_loop
zero_nt_done:
  ; clear best_found_flag
  load s7, BEST_FOUND_FLAG
  load s0, 0
  store s0, (s7)
return

; -------------------------
; READ_DIGIT: call UART_RX -> s9 contains char
; returns digit in s0 (0..9); ignores non-digits
READ_DIGIT:
  call UART_RX
  load s1, "0"
  compare s9, s1
  jump nc, maybe_digit
  jump READ_DIGIT
maybe_digit:
  load s1, "9" + 1 ; If we load "9" here and not ("9" + 1), the program will run into an infinite loop whenever the input contains a digit 9.
  compare s9, s1
  jump nc, not_digit
  ; it's a digit: s0 = s9 - '0'
  load s1, "0"
  sub s9, s1
  load s0, s9
  return
not_digit:
  jump READ_DIGIT

; -------------------------
; Read six digits and fill counts[0..9]
namereg s2, digits_read
namereg s5, counts_pointer
read_six_digits:
  load digits_read, 0
read_six_loop:
  compare digits_read, ATTEMPT_LENGTH
  jump z, read_six_done
  call READ_DIGIT    ; s0 = digit
  ; increment counts[s0]
  load counts_pointer, COUNTS_BASE
  load s3, s0
  compare s3, 0
  jump z, read_six_store
read_six_addloop:
  add counts_pointer, 1
  sub s3, 1
  jump nz, read_six_addloop
read_six_store:
  fetch s6, (counts_pointer)
  add s6, 1
  store s6, (counts_pointer)
  add digits_read, 1
  jump read_six_loop
read_six_done:
return

; -------------------------
; Backtracking search (iterative)
; Search register aliases
namereg s2, search_depth
namereg s3, candidate_digit
namereg s4, next_try_pointer
namereg s5, pointer_offset
namereg s6, scratchpad_pointer
namereg s7, used_counts_pointer
namereg s8, used_digit_count
namereg s9, available_digit_count
backtracking_search:
  load search_depth, 0
  ; next_try[0] already zero
search_loop:
  compare search_depth, ATTEMPT_LENGTH
  jump z, evaluate_attempt
  ; compute pointer = NEXT_TRY_BASE + depth
  load scratchpad_pointer, NEXT_TRY_BASE
  load pointer_offset, search_depth
  compare pointer_offset, 0
  jump z, nt_have_ptr
nt_addloop:
  add scratchpad_pointer, 1
  sub pointer_offset, 1
  jump nz, nt_addloop
nt_have_ptr:
  fetch candidate_digit, (scratchpad_pointer)
try_digit_loop:
  compare candidate_digit, DIGIT_COUNT
  jump z, backtrack
  ; check counts_used[candidate_digit] < counts[candidate_digit]
  load used_counts_pointer, COUNTS_USED_BASE
  load pointer_offset, candidate_digit
  compare pointer_offset, 0
  jump z, used_have_ptr
used_addloop:
  add used_counts_pointer, 1
  sub pointer_offset, 1
  jump nz, used_addloop
used_have_ptr:
  fetch used_digit_count, (used_counts_pointer)
  load scratchpad_pointer, COUNTS_BASE
  load pointer_offset, candidate_digit
  compare pointer_offset, 0
  jump z, counts_have_ptr
counts_addloop:
  add scratchpad_pointer, 1
  sub pointer_offset, 1
  jump nz, counts_addloop
counts_have_ptr:
  fetch available_digit_count, (scratchpad_pointer)
  compare used_digit_count, available_digit_count
  jump nc, digit_not_available
  ; attempt[depth] = candidate_digit
  load pointer_offset, ATTEMPT_BASE
  load scratchpad_pointer, search_depth
  compare scratchpad_pointer, 0
  jump z, at_ptr_ready
at_addloop:
  add pointer_offset, 1
  sub scratchpad_pointer, 1
  jump nz, at_addloop
at_ptr_ready:
  store candidate_digit, (pointer_offset)
  add used_digit_count, 1
  store used_digit_count, (used_counts_pointer)
  ; set next_try[depth] = candidate_digit + 1
  load next_try_pointer, NEXT_TRY_BASE
  load pointer_offset, search_depth
  compare pointer_offset, 0
  jump z, nt2_ready
nt2_addloop:
  add next_try_pointer, 1
  sub pointer_offset, 1
  jump nz, nt2_addloop
nt2_ready:
  add candidate_digit, 1
  store candidate_digit, (next_try_pointer)
  ; advance depth
  add search_depth, 1
  ; set next_try[new depth] = 0
  load next_try_pointer, NEXT_TRY_BASE
  load pointer_offset, search_depth
  compare pointer_offset, 0
  jump z, ntnew_ready
ntnew_addloop:
  add next_try_pointer, 1
  sub pointer_offset, 1
  jump nz, ntnew_addloop
ntnew_ready:
  load s0, 0
  store s0, (next_try_pointer)
  jump search_loop

digit_not_available:
  add candidate_digit, 1
  load next_try_pointer, NEXT_TRY_BASE
  load pointer_offset, search_depth
  compare pointer_offset, 0
  jump z, nt3_ready
nt3_addloop:
  add next_try_pointer, 1
  sub pointer_offset, 1
  jump nz, nt3_addloop
nt3_ready:
  store candidate_digit, (next_try_pointer)
  jump try_digit_loop

backtrack:
  compare search_depth, 0
  jump z, done_search
  sub search_depth, 1
  load pointer_offset, ATTEMPT_BASE
  load scratchpad_pointer, search_depth
  compare scratchpad_pointer, 0
  jump z, at2_ready
at2_addloop:
  add pointer_offset, 1
  sub scratchpad_pointer, 1
  jump nz, at2_addloop
at2_ready:
  fetch candidate_digit, (pointer_offset)
  load used_counts_pointer, COUNTS_USED_BASE
  load scratchpad_pointer, candidate_digit
  compare scratchpad_pointer, 0
  jump z, used2_ready
used2_addloop:
  add used_counts_pointer, 1
  sub scratchpad_pointer, 1
  jump nz, used2_addloop
used2_ready:
  fetch used_digit_count, (used_counts_pointer)
  sub used_digit_count, 1
  store used_digit_count, (used_counts_pointer)
  jump search_loop

done_search:
return

; -------------------------
; evaluate_attempt: depth==6
evaluate_attempt:
  ; fetch attempt digits into registers r0..r5 -> use s0..s6
  fetch s0, ATTEMPT_BASE       ; a
  fetch s1, ATTEMPT_BASE + 1   ; b
  fetch s2, ATTEMPT_BASE + 2   ; c
  fetch s3, ATTEMPT_BASE + 3   ; d
  fetch s4, ATTEMPT_BASE + 4   ; e
  fetch s6, ATTEMPT_BASE + 5   ; f -> stored in s6
  
  ; Now let's fulfill the requirement that the two numbers must be three-digit
  ; ones (to correctly solve the test case "2 3 0 0 9 0").
  compare s0, 0
  jump z, sum_invalid
  compare s3, 0
  jump z, sum_invalid
  
  ; Let's attempt to speed it up a bit, to eliminate obviously invalid sums.
  load sf, s0
  add sf, s3
  compare sf, 10
  jump nc, sum_invalid
  compare sf, 9
  jump nz, the_first_digit_of_the_sum_is_not_9
  load sf, s1
  add sf, s4
  compare sf, 10
  jump nc, sum_invalid
  the_first_digit_of_the_sum_is_not_9:

  ; compute firstNumber into (s7:s8) 16-bit (low: s7, high: s8)
  load s7, 0
  load s8, 0
  ; add a*100
  load s9, s0
  compare s9, 0
  jump z, fn_after_a100
fn_a100_loop:
  ; add 100 to s7/s8
  load sb, HUNDRED
  add s7, sb
  compare s7, sb
  jump nc, fn_a100_nocarry
  add s8, 1
fn_a100_nocarry:
  sub s9, 1
  jump nz, fn_a100_loop
fn_after_a100:
  ; add b*10
  load s9, s1
  compare s9, 0
  jump z, fn_after_b10
fn_b10_loop:
  load sb, TEN
  add s7, sb
  compare s7, sb
  jump nc, fn_b10_nocarry
  add s8, 1
fn_b10_nocarry:
  sub s9, 1
  jump nz, fn_b10_loop
fn_after_b10:
  ; add c
  add s7, s2
  compare s7, s2
  jump nc, fn_no_carry_inc
  add s8, 1
fn_no_carry_inc:

  ; compute secondNumber into (s0:s1) low:s0 high:s1
  load s0, 0
  load s1, 0
  ; d*100
  load s9, s3
  compare s9, 0
  jump z, sn_after_d100
sn_d100_loop:
  load sb, HUNDRED
  add s0, sb
  compare s0, sb
  jump nc, sn_d100_nocarry
  add s1, 1
sn_d100_nocarry:
  sub s9, 1
  jump nz, sn_d100_loop
sn_after_d100:
  ; e*10
  load s9, s4
  compare s9, 0
  jump z, sn_after_e10
sn_e10_loop:
  load sb, TEN
  add s0, sb
  compare s0, sb
  jump nc, sn_e10_nocarry
  add s1, 1
sn_e10_nocarry:
  sub s9, 1
  jump nz, sn_e10_loop
sn_after_e10:
  ; + f (s6)
  add s0, s6
  compare s0, s6
  jump nc, sn_no_carry_inc
  add s1, 1
sn_no_carry_inc:

  ; IMMEDIATELY SAVE firstNumber (s7:s8) and secondNumber (s0:s1) to candidate storage (51-54)
  ; This protects them from being clobbered by any subsequent operations
  store s7, CANDIDATE_FIRST_LOW
  store s8, CANDIDATE_FIRST_HIGH
  store s0, CANDIDATE_SECOND_LOW
  store s1, CANDIDATE_SECOND_HIGH

  ; sum = first + second -> store in s2 (lo), s3 (hi)
  load s2, s7
  add s2, s0
  compare s2, s0
  jump nc, sum_no_carry
  ; carry
  load s3, s8
  add s3, s1
  add s3, 1
  jump sum_done
sum_no_carry:
  load s3, s8
  add s3, s1
sum_done:

  ; check sum < MAX_SUM_EXCLUSIVE
  constant upper_byte_of_limit, bitand(MAX_SUM_EXCLUSIVE, invertBits(ff'x)) / 2 ^ 8
  if NDEBUG = 0
    display "Debugging the preprocessor: Upper limit is "
    display upper_byte_of_limit + "0"
    display "*256+"
    display bitor(bitand(MAX_SUM_EXCLUSIVE, ff'x) / 100, 0) + "0"
    display "*100+"
    display bitor(mod(bitand(MAX_SUM_EXCLUSIVE, ff'x) / 10, 10), 0) + "0"
    display "*10+"
    display mod(bitand(MAX_SUM_EXCLUSIVE, ff'x), 10) + "0"
    display a'x
  endif
  compare s3, upper_byte_of_limit
  jump nc, sum_ge_1000
  jump sum_valid
sum_ge_1000:
  compare s3, upper_byte_of_limit
  jump nz, sum_invalid
  ; s3 == upper_byte_of_limit -> check s2 < (MAX_SUM_EXCLUSIVE & 0xff)
  load sb, bitand(MAX_SUM_EXCLUSIVE, ff'x)
  compare s2, sb
  jump nc, sum_invalid
  jump sum_valid
sum_invalid:
  ; invalid -> backtrack: release last digit and set next_try accordingly
  ; release digit at depth-1 (index 5)
  load s5, ATTEMPT_BASE
  add s5, LAST_ATTEMPT_INDEX
  fetch s9, (s5)
  ; decrement counts_used[s9]
  load s7, COUNTS_USED_BASE
  load s8, s9
  compare s8, 0
  jump z, used_rel_done
used_rel_addloop:
  add s7, 1
  sub s8, 1
  jump nz, used_rel_addloop
used_rel_done:
  fetch s0, (s7)
  sub s0, 1
  store s0, (s7)
  ; set next_try[5] = s9 + 1
  load s4, NEXT_TRY_BASE
  add s4, LAST_ATTEMPT_INDEX
  add s9, 1
  store s9, (s4)
  ; set depth = 5 and resume
  load s2, LAST_ATTEMPT_INDEX
  jump search_loop

sum_valid:
  ; sum < 1000; compare with best
  load s7, BEST_FOUND_FLAG
  fetch sa, (s7)
  compare sa, 0
  jump z, update_best
  ; fetch best sum
  fetch s4, BEST_SUM_LOW
  fetch s5, BEST_SUM_HIGH
  ; compare s3:s2 (sum hi:lo) to s5:s4 (best hi:lo)
  compare s3, s5
  jump nc, sum_hi_ge_best_hi
  ; sum_hi < best_hi -> no update
  jump after_eval
sum_hi_ge_best_hi:
  compare s3, s5
  jump z, compare_sum_lo
  ; sum_hi > best_hi -> update
  jump update_best
compare_sum_lo:
  compare s2, s4
  jump nz, sum_lo_diff
  ; equal -> no update
  ; jump after_eval ; If you uncomment this line, the first number in the sum will be smaller (rather than bigger).
sum_lo_diff:
  ; if sumLo >= bestLo then update, else skip
  compare s2, s4
  jump nc, update_best
  jump z, update_best ; So that the first number in the sum is the bigger one.
  jump after_eval

update_best:
  jump NDEBUG ? dont_print_the_current_optimum : print_the_current_optimum
  print_the_current_optimum:
    print_string "Found a new optimum: ", s9, UART_TX
    load sf, ATTEMPT_BASE
    printing_the_current_optimum_loop:
      compare sf, ATTEMPT_BASE + ATTEMPT_LENGTH
      jump nc, end_of_the_printing_the_current_optimum_loop
      fetch s9, (sf)
      add s9, "0"
      call UART_TX
      compare sf, ATTEMPT_BASE + ATTEMPT_LENGTH / 2 - 1
      jump nz, dont_print_the_plus_sign
        load s9, "+"
        call UART_TX
      dont_print_the_plus_sign:
      add sf, 1
      jump printing_the_current_optimum_loop
    end_of_the_printing_the_current_optimum_loop:
    load s9, a'x
    call UART_TX
  dont_print_the_current_optimum:
  load sb, 1
  store sb, BEST_FOUND_FLAG
  store s2, BEST_SUM_LOW
  store s3, BEST_SUM_HIGH
  fetch sa, CANDIDATE_FIRST_LOW
  store sa, BEST_FIRST_LOW
  fetch sa, CANDIDATE_FIRST_HIGH
  store sa, BEST_FIRST_HIGH
  fetch sa, CANDIDATE_SECOND_LOW
  store sa, BEST_SECOND_LOW
  fetch sa, CANDIDATE_SECOND_HIGH
  store sa, BEST_SECOND_HIGH
after_eval:
  ; release last digit (index 5) and prepare backtracking
  load s5, ATTEMPT_BASE
  add s5, LAST_ATTEMPT_INDEX
  fetch s9, (s5)
  ; decrement counts_used[s9]
  load s7, COUNTS_USED_BASE
  load s8, s9
  compare s8, 0
  jump z, used_rel_done2
used_rel2_addloop:
  add s7, 1
  sub s8, 1
  jump nz, used_rel2_addloop
used_rel_done2:
  fetch s0, (s7)
  sub s0, 1
  store s0, (s7)
  ; set next_try[5] = s9 + 1
  load s4, NEXT_TRY_BASE
  add s4, LAST_ATTEMPT_INDEX
  add s9, 1
  store s9, (s4)
  ; set depth = 5
  load s2, LAST_ATTEMPT_INDEX
  jump search_loop

; -------------------------
; print_result
print_result:
  ; fetch best_found_flag
  load s7, BEST_FOUND_FLAG
  fetch s0, (s7)
  compare s0, 0
  jump z, print_bilbo
  ; The following code will check whether the second number is smaller
  ; than 100, which it must not be. It's still not a complete solution to that
  ; problem, because it will output "Bilbo" for "2 3 0 0 9 0", when, in reality,
  ; the solution is "590=390+200".
  fetch sf, BEST_SECOND_HIGH
  compare sf, 0
  jump nz, second_number_is_bigger_than_99
  fetch sf, BEST_SECOND_LOW
  compare sf, HUNDRED
  jump c, print_bilbo
  second_number_is_bigger_than_99:
  ; fetch sum
  fetch s4, BEST_SUM_LOW
  fetch s5, BEST_SUM_HIGH
  ; call print routine (expects s4=lo, s5=hi)
  call PRINT_UINT_LT1000_FROM_S4_S5
  ; print '='
  load s9, "="
  call UART_TX
  ; print best first number (55..56)
  fetch s4, BEST_FIRST_LOW
  fetch s5, BEST_FIRST_HIGH
  call PRINT_UINT_LT1000_FROM_S4_S5
  ; print '+'
  load s9, "+"
  call UART_TX
  ; print best second number (57..58)
  fetch s4, BEST_SECOND_LOW
  fetch s5, BEST_SECOND_HIGH
  call PRINT_UINT_LT1000_FROM_S4_S5
  load s9, a'x
  call UART_TX
  jump print_done
print_bilbo:
  print_string "Bilbo -- There is no solution!\n", s9, UART_TX
print_done:
return

; -------------------------
; PRINT_UINT_LT1000_FROM_S4_S5: prints 16-bit value (<1000) in s4 (lo), s5 (hi)
namereg s0, tens_digit
namereg s6, value_low
namereg s7, value_high
namereg s8, hundreds_digit
PRINT_UINT_LT1000_FROM_S4_S5:
  load value_low, s4
  load value_high, s5
  load hundreds_digit, 0
hundreds_loop_p:
  ; if (tHi,tLo) < 100 -> stop
  load sb, HUNDRED
  compare value_high, 0
  jump nz, can_sub100_p
  compare value_low, sb
  jump nc, can_sub100_p
  jump hundreds_done_p
can_sub100_p:
  compare value_low, sb
  jump nc, sub100_no_borrow_p
  sub value_low, sb
  sub value_high, 1
  jump sub100_done_p
sub100_no_borrow_p:
  sub value_low, sb
sub100_done_p:
  add hundreds_digit, 1
  jump hundreds_loop_p
hundreds_done_p:
  load tens_digit, 0
tens_loop_p:
  load sb, TEN
  compare value_high, 0
  jump nz, can_sub10_p
  compare value_low, sb
  jump nc, can_sub10_p
  jump tens_done_p
can_sub10_p:
  compare value_low, sb
  jump nc, sub10_no_borrow_p
  sub value_low, sb
  sub value_high, 1
  jump sub10_done_p
sub10_no_borrow_p:
  sub value_low, sb
sub10_done_p:
  add tens_digit, 1
  jump tens_loop_p
tens_done_p:
  ; units in s6 now
  ; print
  compare hundreds_digit, 0
  jump z, skip_hundreds_print_p
  load sb, "0"
  add hundreds_digit, sb
  load s9, hundreds_digit
  call UART_TX
skip_hundreds_print_p:
  compare hundreds_digit, 0
  jump nz, print_tens_and_units_after_hundreds_p
  compare tens_digit, 0
  jump z, print_units_only_p
  ; print tens and units
  load sb, "0"
  add tens_digit, sb
  load s9, tens_digit
  call UART_TX
  load sb, "0"
  add value_low, sb
  load s9, value_low
  call UART_TX
  jump print_end_p
print_units_only_p:
  load sb, "0"
  add value_low, sb
  load s9, value_low
  call UART_TX
  jump print_end_p
print_tens_and_units_after_hundreds_p:
  load sb, "0"
  add tens_digit, sb
  load s9, tens_digit
  call UART_TX
  load sb, "0"
  add value_low, sb
  load s9, value_low
  call UART_TX
print_end_p:
return

; -------------------------
; UART boilerplate from repository
base_hexadecimal
CONSTANT LED_PORT,         00
CONSTANT HEX1_PORT,        01
CONSTANT HEX2_PORT,        02
CONSTANT UART_TX_PORT,     03
CONSTANT UART_RESET_PORT,  04
CONSTANT SW_PORT,          00
CONSTANT BTN_PORT,         01
CONSTANT UART_STATUS_PORT, 02
CONSTANT UART_RX_PORT,     03
; Tx data_present
CONSTANT U_TX_D, 00000001'b
; Tx FIFO half_full
CONSTANT U_TX_H, 00000010'b
; TxFIFO full
CONSTANT U_TX_F, 00000100'b
; Rxdata_present
CONSTANT U_RX_D, 00001000'b
; RxFIFO half_full
CONSTANT U_RX_H, 00010000'b
; RxFIFO full
CONSTANT U_RX_F, 00100000'b

UART_RX:
  INPUT sA, UART_STATUS_PORT
  TEST  sA, U_RX_D
  JUMP  NZ, input_not_empty
    LOAD  s0, s0
    JUMP UART_RX
  input_not_empty:
  INPUT s9, UART_RX_PORT
RETURN

UART_TX:
  INPUT  sA, UART_STATUS_PORT
  TEST   sA, U_TX_F
  JUMP   NZ, UART_TX
  OUTPUT s9, UART_TX_PORT
RETURN
