;A very advanced example: Implementing the permutations algorithm in PicoBlaze assembly.
;For sorting, we will use the Bubble Sort algorithm. And we will use stack instead of recursion.

base_decimal

constant DEBUG_DISABLED, 1
constant addr_current_attempt, 8
constant ordinal_digits_addr, 16
constant stack_bottom, 24
constant assume_sorting_works, 1 ; See https://www.reddit.com/r/asm/comments/1qlxfrw/ — noted ~11% speedup

address 0

namereg sf, length_of_the_input

regbank a
call print_the_introduction_message
load length_of_the_input, 0
input_loop_start:
  call UART_RX
  compare s9, a'x ;The new-line character.
  jump z, input_loop_end
  store s9, (length_of_the_input)
  add length_of_the_input, 1
  jump input_loop_start
input_loop_end:
compare length_of_the_input, 0
jump z, 0

;An improved version of BubbleSort by Sep Roland - see https://codereview.stackexchange.com/a/295950
namereg s0, first_pointer_in_BubbleSort
namereg s1, second_pointer_in_BubbleSort
namereg s2, value_at_the_first_pointer_in_BubbleSort
namereg s3, value_at_the_second_pointer_in_BubbleSort
namereg s4, has_a_swap_been_performed_in_BubbleSort
namereg s5, retracting_limit_of_the_second_pointer_in_BubbleSort
bubble_sort_start:
    load    retracting_limit_of_the_second_pointer_in_BubbleSort, length_of_the_input
  bubble_outer_loop:
    sub     retracting_limit_of_the_second_pointer_in_BubbleSort, 1
    jump    z,  bubble_sort_end
    load    has_a_swap_been_performed_in_BubbleSort, 0
    load    second_pointer_in_BubbleSort, 0
  bubble_inner_loop:
    compare second_pointer_in_BubbleSort, retracting_limit_of_the_second_pointer_in_BubbleSort
    jump    nc, bubble_inner_loop_end
    load    first_pointer_in_BubbleSort, second_pointer_in_BubbleSort
    add     second_pointer_in_BubbleSort, 1
    fetch   value_at_the_first_pointer_in_BubbleSort, (first_pointer_in_BubbleSort)
    fetch   value_at_the_second_pointer_in_BubbleSort, (second_pointer_in_BubbleSort)
    compare value_at_the_second_pointer_in_BubbleSort, value_at_the_first_pointer_in_BubbleSort
    jump    nc, bubble_inner_loop
    store   value_at_the_second_pointer_in_BubbleSort, (first_pointer_in_BubbleSort)
    store   value_at_the_first_pointer_in_BubbleSort, (second_pointer_in_BubbleSort)
    load    has_a_swap_been_performed_in_BubbleSort, 1
    jump    bubble_inner_loop
  bubble_inner_loop_end:
    test    has_a_swap_been_performed_in_BubbleSort, has_a_swap_been_performed_in_BubbleSort
    jump    nz, bubble_outer_loop
bubble_sort_end:

jump DEBUG_DISABLED ? permutations_main : print_sorted_array
print_sorted_array:
call print_the_sorted_array_message
load s0, 0
print_sorted_array_loop:
  compare s0, length_of_the_input
  jump nc, print_sorted_array_loop_end
  fetch s9, (s0)
  call UART_TX
  add s0, 1
  jump print_sorted_array_loop
print_sorted_array_loop_end:
load s9, a'x
call UART_TX

permutations_main:

;Let's set all the digits of the ordinal number of permutations to "0"
regbank b
load s0, ordinal_digits_addr
load s2, ordinal_digits_addr ;End of the digits of the ordinal number.
reset_ordinal_numbers:
  compare s0, stack_bottom
  jump nc, reset_ordinal_numbers_end
  load s1, "0"
  store s1, (s0)
  add s0, 1
  jump reset_ordinal_numbers
reset_ordinal_numbers_end:
regbank a

namereg se, top_of_the_stack
load top_of_the_stack, stack_bottom
load s0, 0
store s0, (top_of_the_stack)
add top_of_the_stack, length_of_the_input
add top_of_the_stack, 1
permutations_loop_start:
  compare top_of_the_stack, stack_bottom
  jump z, permutations_loop_end
  sub top_of_the_stack, length_of_the_input
  sub top_of_the_stack, 1
  namereg sd, length_of_the_current_attempt
  fetch length_of_the_current_attempt, (top_of_the_stack)
  load s0, addr_current_attempt
  store length_of_the_current_attempt, (s0)
  load s1, 0
  copy_current_attempt_from_stack:
    compare s1, length_of_the_current_attempt
    jump nc, copy_current_attempt_end
    load s0, addr_current_attempt
    add s0, s1
    add s0, 1
    load s3, top_of_the_stack
    add s3, s1
    add s3, 1
    fetch s4, (s3)
    store s4, (s0)
    add s1, 1
    jump copy_current_attempt_from_stack
  copy_current_attempt_end:
  jump DEBUG_DISABLED ? skip_print_current_attempt : print_current_attempt
  print_current_attempt:
  call print_the_length_of_the_current_attempt_message
  load s9, length_of_the_current_attempt
  add s9, "0"
  call UART_TX
  load s9, a'x
  call UART_TX
  call print_the_current_attempt_message
  load s0, addr_current_attempt + 1
  print_current_attempt_loop:
    load s1, addr_current_attempt + 1
    add s1, length_of_the_current_attempt
    compare s0, s1
    jump nc, print_current_attempt_loop_end
    fetch s9, (s0)
    call UART_TX
    add s0, 1
    jump print_current_attempt_loop
  print_current_attempt_loop_end:
  load s9, a'x
  call UART_TX
  skip_print_current_attempt:
  compare length_of_the_current_attempt, length_of_the_input
  jump c, attempt_not_solution
    call print_found_a_solution_message
    load s0, addr_current_attempt + 1
    print_solution_loop:
      load s1, addr_current_attempt + 1
      add s1, length_of_the_current_attempt
      compare s0, s1
      jump nc, print_solution_loop_end
      fetch s9, (s0)
      call UART_TX
      add s0, 1
      jump print_solution_loop
    print_solution_loop_end:
    load s9, a'x
    call UART_TX
    regbank b
    call print_the_ordinal_number_message
    load s1, ordinal_digits_addr
    increment_ordinal_number:
      fetch s0, (s1)
      add s0, 1
      store s0, (s1)
      compare s0, "9" + 1
      jump nz, increment_ordinal_number_end
      load s0, "0"
      store s0, (s1)
      add s1, 1
      jump increment_ordinal_number
    increment_ordinal_number_end:
    compare s1, s2
    jump c, not_new_digit
      load s2, s1
    not_new_digit:
    load s1, s2
    print_ordinal_number:
      fetch s9, (s1)
      call UART_TX
      sub s1, 1
      compare s1, ordinal_digits_addr
      jump nc, print_ordinal_number
    print_ordinal_number_end:
    load s9, a'x
    call UART_TX
    regbank a
  jump branch_end
  attempt_not_solution:
    load s0, length_of_the_input
    sub s0, 1
    add_new_character_loop:
      ;No check at the beginning of this loop, for this is a do-while-loop,
      ;rather than a while-loop. Checking whether an overflow has occurred
      ;when decreasing the pointer stored in s0 by 1 is done at the end of
      ;this loop.
      namereg sc, character_we_try_to_add
      fetch character_we_try_to_add, (s0)
      load s7, s0
      add s7, 1
      jump assume_sorting_works ? dont_loop_toward_the_end : loop_toward_the_end
      loop_toward_the_end:
        load s8, 0 ;Whether we already tried adding that character.
        check_already_tried_char:
          compare s7, length_of_the_input
          jump nc, check_already_tried_char_end
          fetch s6, (s7)
          compare s6, character_we_try_to_add
          jump nz, third_chars_not_equal
            load s8, 1
          third_chars_not_equal:
          add s7, 1
          jump check_already_tried_char
        check_already_tried_char_end:
        jump test_s8_set
      dont_loop_toward_the_end:
        load s8, 0
        compare s7, length_of_the_input
        jump nc, test_s8_set
        fetch s6, (s7)
        compare character_we_try_to_add, s6
        jump nz, fourth_chars_not_equal
          load s8, 1 ; When "addzy" fails to assemble, for some reason.
        fourth_chars_not_equal:
        jump test_s8_set
      test_s8_set:
      test s8, s8
      jump nz, skip_add_new_character
      jump DEBUG_DISABLED ? skip_print_trying_character : print_trying_character
      print_trying_character:
        call print_we_are_trying_to_add_message
        load s9, character_we_try_to_add
        call UART_TX
        load s9, a'x
        call UART_TX
      skip_print_trying_character:
      load s2, 0 ; How many of the chosen character are present in the current attempt.
      load s1, addr_current_attempt + 1
      count_in_current_attempt:
        load s4, addr_current_attempt + 1
        add s4, length_of_the_current_attempt
        compare s1, s4
        jump z, count_in_current_attempt_end
        fetch s4, (s1)
        compare s4, character_we_try_to_add
        jump nz, first_chars_not_equal
          add s2, 1
        first_chars_not_equal:
        add s1, 1
        jump count_in_current_attempt
      count_in_current_attempt_end:
      jump DEBUG_DISABLED ? skip_print_current_attempt_count : print_current_attempt_count
      print_current_attempt_count:
        call print_the_current_attempt_count_message
        load s9, s2
        add s9, "0"
        call UART_TX
        load s9, a'x
        call UART_TX
      skip_print_current_attempt_count:
      load s3, 0 ; How many of the chosen character are present in the input.
      load s1, 0
      count_in_input:
        compare s1, length_of_the_input
        jump z, count_in_input_end
        fetch s4, (s1)
        compare s4, character_we_try_to_add
        jump nz, second_the_characters_are_not_equal_label
          add s3, 1
        second_the_characters_are_not_equal_label:
        add s1, 1
        jump count_in_input
      count_in_input_end:
      jump DEBUG_DISABLED ? skip_print_input_count : print_input_count
      print_input_count:
        call print_count_in_the_input_message
        load s9, s3
        add s9, "0"
        call UART_TX
        load s9, a'x
        call UART_TX
      skip_print_input_count:
      compare s2, s3
      jump nc, skip_add_new_character
        load s1, DEBUG_DISABLED
        test s1, s1
        call z, print_the_we_are_adding_the_new_character_message
        load s1, top_of_the_stack
        load s2, length_of_the_current_attempt
        add s2, 1
        store s2, (s1)
        add s1, 1
        load s3, addr_current_attempt + 1
        copying_the_new_attempt_loop:
          load s5, addr_current_attempt + 1
          add s5, length_of_the_current_attempt
          compare s3, s5
          jump z, end_of_the_copying_the_new_attempt_loop
          fetch s4, (s3)
          store s4, (s1)
          add s3, 1
          add s1, 1
          jump copying_the_new_attempt_loop
        end_of_the_copying_the_new_attempt_loop:
        ;s1 now points to the location right after the copied attempt.
        store character_we_try_to_add, (s1)
        add top_of_the_stack, length_of_the_input
        add top_of_the_stack, 1
      skip_add_new_character:
      sub s0, 1
      jump nc, add_new_character_loop
    add_new_character_loop_end:
    load sb, DEBUG_DISABLED
    compare sb, 0
    call z, print_the_exited_the_loop_message
  branch_end:
  jump permutations_loop_start
permutations_loop_end:
call print_the_end_message
;Let's test whether we are on real PicoBlaze, or on the PicoBlaze assembler and emulator in JavaScript made by Teo Samaržija et aliis.
regbank a
load sa, 0
sub  sa, 0
regbank b
load sa, 1
sub  sa, 0
regbank a
jump z , we_are_in_the_simulator
jump nz, we_are_on_a_real_PicoBlaze
jump cannot_determine_the_environment
we_are_on_a_real_PicoBlaze:
;If we are on a real PicoBlaze, let's form an infinite loop.
jump 0
we_are_in_the_simulator:
;Then, let's exit the program.
return z
cannot_determine_the_environment:
print_string "Cannot determine the environment this program is run in, aborting!\n", s9, UART_TX
infinite_loop: jump infinite_loop

print_the_introduction_message:
  print_string "Enter a short string and press enter.\n", s9, UART_TX
return

print_the_sorted_array_message:
  print_string "After the Bubble Sort algorithm, the input string looks like this: ", s9, UART_TX
return

print_the_current_attempt_message:
  print_string "The current attempt is: ", s9, UART_TX
return

print_we_are_trying_to_add_message:
  print_string "We are trying to add the character: ", s9, UART_TX
return

print_the_current_attempt_count_message:
  print_string "The count of that character in the current attempt is: ", s9, UART_TX
return

print_count_in_the_input_message:
  print_string "The count of that character in the input string is: ", s9, UART_TX
return

print_the_we_are_adding_the_new_character_message:
  print_string "We will try to add that character.\n", s9, UART_TX
return

print_found_a_solution_message:
  print_string "Found a permutation: ", s9, UART_TX
return

print_the_end_message:
  print_string "The end!\n", s9, UART_TX
return

print_the_length_of_the_current_attempt_message:
  print_string "The length of the current attempt is: ", s9, UART_TX
return

print_the_ordinal_number_message:
  print_string "That's the permutation #", s9, UART_TX
return

print_the_exited_the_loop_message:
  print_string "The 'add_new_character_loop' loop has exited!\n", s9, UART_TX
return

base_hexadecimal
;Now follows some boilerplate code
;we use in our Computer Architecture
;classes...
CONSTANT LED_PORT,         00
CONSTANT HEX1_PORT,        01
CONSTANT HEX2_PORT,        02
CONSTANT UART_TX_PORT,     03
CONSTANT UART_RESET_PORT,  04
CONSTANT SW_PORT,          00
CONSTANT BTN_PORT,         01
CONSTANT UART_STATUS_PORT, 02
CONSTANT UART_RX_PORT,     03
; Tx data_present
CONSTANT U_TX_D, 00000001'b
; Tx FIFO half_full
CONSTANT U_TX_H, 00000010'b
; TxFIFO full
CONSTANT U_TX_F, 00000100'b
; Rxdata_present
CONSTANT U_RX_D, 00001000'b
; RxFIFO half_full
CONSTANT U_RX_H, 00010000'b
; RxFIFO full
CONSTANT U_RX_F, 00100000'b

UART_RX:
  INPUT sA, UART_STATUS_PORT
  TEST  sA, U_RX_D
  JUMP  NZ, input_not_empty
    LOAD  s0, s0
    JUMP UART_RX
  input_not_empty:
  INPUT s9, UART_RX_PORT
RETURN

UART_TX:
  INPUT  sA, UART_STATUS_PORT
  TEST   sA, U_TX_F
  JUMP   NZ, UART_TX
  OUTPUT s9, UART_TX_PORT
RETURN

;See WebAssembly implementation: https://flatassembler.github.io/permutationsTest.html
;Related StackExchange thread: https://codereview.stackexchange.com/q/295882/219010


